{%- comment -%}
  Quantity Breaks — multi-variant bundle selector.
  Accepts: product, block
{%- endcomment -%}

{%- liquid
  assign qb_heading   = block.settings.heading | default: 'Save more when you buy more'
  assign qb_disc2     = block.settings.tier2_discount | default: 5
  assign qb_disc3     = block.settings.tier3_discount | default: 10
  assign qb_disc4     = block.settings.tier4_discount | default: 15
  assign qb_price     = product.selected_or_first_available_variant.price
-%}

<quantity-breaks
  class="quantity-breaks"
  data-product-id="{{ product.id }}"
  data-tiers='[{"qty":2,"disc":{{ qb_disc2 }}},{"qty":3,"disc":{{ qb_disc3 }}},{"qty":4,"disc":{{ qb_disc4 }}}]'
  data-base-price="{{ qb_price }}"
  data-currency="{{ cart.currency.iso_code }}"
  {{ block.shopify_attributes }}
>
  <script type="application/json" data-qb-variants>
    {{ product.variants | json }}
  </script>
  <script type="application/json" data-qb-options>
    {{ product.options_with_values | json }}
  </script>

  <p class="quantity-breaks__heading">{{ qb_heading }}</p>

  <div class="quantity-breaks__tiers" role="radiogroup" aria-label="Bundle quantity">
    {%- assign tier_qtys = '2,3,4' | split: ',' -%}
    {%- assign tier_discs = qb_disc2 | append: ',' | append: qb_disc3 | append: ',' | append: qb_disc4 | split: ',' -%}
    {%- for tier in tier_qtys -%}
      {%- assign disc = tier_discs[forloop.index0] -%}
      {%- assign savings_per_unit = qb_price | times: disc | divided_by: 100 -%}
      {%- assign total_savings = savings_per_unit | times: tier -%}
      <button
        class="quantity-breaks__tier-btn{% if forloop.first %} is-active{% endif %}"
        data-qty="{{ tier }}"
        data-disc="{{ disc }}"
        aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
        type="button"
      >
        <span class="qb-radio"><span class="qb-radio-dot"></span></span>
        <span class="qb-tier-label">
          <span class="qb-tier-qty">Buy {{ tier }}</span>
          <span class="qb-tier-save">Save {{ disc }}%</span>
        </span>
        <span class="qb-tier-savings-amt">{{ total_savings | money }} off</span>
      </button>
    {%- endfor -%}
  </div>

  <div class="quantity-breaks__slots" aria-live="polite"></div>

  <div class="quantity-breaks__footer" hidden>
    <button class="quantity-breaks__cta button button--primary button--full-width" type="button">
      <span class="qb-cta-text">Add to Cart</span>
      <span class="qb-cta-savings"></span>
      {%- render 'loading-spinner' -%}
    </button>
    <p class="quantity-breaks__error" role="alert" hidden></p>
  </div>
</quantity-breaks>
