{% doc %}
  @prompt
    Create a comparison section: Use the heading: Why Our Version Is Better. Then present a comparison table with the following:Feature	GiftMira	Other Stores
    30-Day Guarantee	✅	❌
    US Shipping	✅	❌
    Verified Reviews	✅	❌
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-table-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-comparison-table__container-{{ ai_gen_id }} {
    max-width: 800px;
    margin: 0 auto;
  }

  .ai-comparison-table__heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 32px;
    font-weight: 600;
  }

  .ai-comparison-table__table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: collapse;
    background-color: {{ block.settings.table_background }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-comparison-table__header-{{ ai_gen_id }} {
    background-color: {{ block.settings.header_background }};
  }

  .ai-comparison-table__header-cell-{{ ai_gen_id }} {
    padding: 16px;
    text-align: center;
    font-weight: 600;
    color: {{ block.settings.header_text_color }};
    font-size: {{ block.settings.header_text_size }}px;
    border-bottom: 2px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table__header-cell-{{ ai_gen_id }}:first-child {
    text-align: left;
  }

  .ai-comparison-table__row-{{ ai_gen_id }} {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table__row-{{ ai_gen_id }}:last-child {
    border-bottom: none;
  }

  .ai-comparison-table__cell-{{ ai_gen_id }} {
    padding: 16px;
    text-align: center;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
  }

  .ai-comparison-table__cell-{{ ai_gen_id }}:first-child {
    text-align: left;
    font-weight: 500;
  }

  .ai-comparison-table__icon-{{ ai_gen_id }} {
    font-size: 24px;
    line-height: 1;
  }

  .ai-comparison-table__icon--check-{{ ai_gen_id }} {
    color: {{ block.settings.check_color }};
  }

  .ai-comparison-table__icon--cross-{{ ai_gen_id }} {
    color: {{ block.settings.cross_color }};
  }

  .ai-comparison-table__brand-cell-{{ ai_gen_id }} {
    background-color: {{ block.settings.brand_column_background }};
    font-weight: 600;
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-table-{{ ai_gen_id }} {
      padding: 24px 16px;
    }

    .ai-comparison-table__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.heading_size }}px * 0.8);
      margin-bottom: 24px;
    }

    .ai-comparison-table__header-cell-{{ ai_gen_id }},
    .ai-comparison-table__cell-{{ ai_gen_id }} {
      padding: 12px 8px;
      font-size: calc({{ block.settings.text_size }}px * 0.9);
    }

    .ai-comparison-table__header-cell-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.header_text_size }}px * 0.9);
    }

    .ai-comparison-table__icon-{{ ai_gen_id }} {
      font-size: 20px;
    }
  }
{% endstyle %}

<div class="ai-comparison-table-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-comparison-table__container-{{ ai_gen_id }}">
    <h2 class="ai-comparison-table__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    
    <table class="ai-comparison-table__table-{{ ai_gen_id }}">
      <thead class="ai-comparison-table__header-{{ ai_gen_id }}">
        <tr>
          <th class="ai-comparison-table__header-cell-{{ ai_gen_id }}">{{ block.settings.feature_column_label }}</th>
          <th class="ai-comparison-table__header-cell-{{ ai_gen_id }}">{{ block.settings.brand_column_label }}</th>
          <th class="ai-comparison-table__header-cell-{{ ai_gen_id }}">{{ block.settings.competitor_column_label }}</th>
        </tr>
      </thead>
      <tbody>
        <tr class="ai-comparison-table__row-{{ ai_gen_id }}">
          <td class="ai-comparison-table__cell-{{ ai_gen_id }}">{{ block.settings.feature_1 }}</td>
          <td class="ai-comparison-table__cell-{{ ai_gen_id }} ai-comparison-table__brand-cell-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon--check-{{ ai_gen_id }}">{{ block.settings.check_icon }}</span>
          </td>
          <td class="ai-comparison-table__cell-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon--cross-{{ ai_gen_id }}">{{ block.settings.cross_icon }}</span>
          </td>
        </tr>
        <tr class="ai-comparison-table__row-{{ ai_gen_id }}">
          <td class="ai-comparison-table__cell-{{ ai_gen_id }}">{{ block.settings.feature_2 }}</td>
          <td class="ai-comparison-table__cell-{{ ai_gen_id }} ai-comparison-table__brand-cell-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon--check-{{ ai_gen_id }}">{{ block.settings.check_icon }}</span>
          </td>
          <td class="ai-comparison-table__cell-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon--cross-{{ ai_gen_id }}">{{ block.settings.cross_icon }}</span>
          </td>
        </tr>
        <tr class="ai-comparison-table__row-{{ ai_gen_id }}">
          <td class="ai-comparison-table__cell-{{ ai_gen_id }}">{{ block.settings.feature_3 }}</td>
          <td class="ai-comparison-table__cell-{{ ai_gen_id }} ai-comparison-table__brand-cell-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon--check-{{ ai_gen_id }}">{{ block.settings.check_icon }}</span>
          </td>
          <td class="ai-comparison-table__cell-{{ ai_gen_id }}">
            <span class="ai-comparison-table__icon-{{ ai_gen_id }} ai-comparison-table__icon--cross-{{ ai_gen_id }}">{{ block.settings.cross_icon }}</span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Our Version Is Better"
    },
    {
      "type": "text",
      "id": "feature_column_label",
      "label": "Feature column label",
      "default": "Feature"
    },
    {
      "type": "text",
      "id": "brand_column_label",
      "label": "Your brand column label",
      "default": "GiftMira"
    },
    {
      "type": "text",
      "id": "competitor_column_label",
      "label": "Competitor column label",
      "default": "Other Stores"
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Feature 1",
      "default": "30-Day Guarantee"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "US Shipping"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Verified Reviews"
    },
    {
      "type": "text",
      "id": "check_icon",
      "label": "Check icon",
      "default": "✅"
    },
    {
      "type": "text",
      "id": "cross_icon",
      "label": "Cross icon",
      "default": "❌"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "table_background",
      "label": "Table background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "header_background",
      "label": "Header background",
      "default": "#f4f4f4"
    },
    {
      "type": "color",
      "id": "brand_column_background",
      "label": "Brand column background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "header_text_color",
      "label": "Header text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "check_color",
      "label": "Check icon",
      "default": "#008060"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Cross icon",
      "default": "#D82C0D"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "header_text_size",
      "label": "Header text size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "Comparison table"
    }
  ]
}
{% endschema %}
