{% doc %}
  @prompt
    Horizontal scrolling row of collections with circular images, title, and hover float effect.
    GiftMira brand: Mira Gold accents, EB Garamond heading, Mira Ivory backgrounds.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .gm-occasions-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 0;
  }

  .gm-occasions-container-{{ ai_gen_id }} {
    width: 100%;
    margin: 0 auto;
  }

  .gm-occasions-container-{{ ai_gen_id }}.full-width {
    max-width: 100%;
    padding: 0 20px;
  }

  .gm-occasions-container-{{ ai_gen_id }}.container {
    max-width: 1200px;
    padding: 0 20px;
  }

  .gm-occasions-title-{{ ai_gen_id }} {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 30px;
    text-align: {{ block.settings.title_alignment }};
  }

  .gm-occasions-list-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.spacing }}px;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 10px 0 16px;
    scrollbar-width: thin;
    scrollbar-color: {{ block.settings.scrollbar_color }} transparent;
  }

  .gm-occasions-list-{{ ai_gen_id }}::-webkit-scrollbar {
    height: 6px;
  }

  .gm-occasions-list-{{ ai_gen_id }}::-webkit-scrollbar-track {
    background: transparent;
  }

  .gm-occasions-list-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
    background-color: {{ block.settings.scrollbar_color }};
    border-radius: 4px;
  }

  .gm-occasions-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .gm-occasions-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
  }

  .gm-occasions-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    border-radius: 50%;
    overflow: hidden;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    background-color: {{ block.settings.image_background }};
    flex-shrink: 0;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .gm-occasions-item-{{ ai_gen_id }}:hover .gm-occasions-image-wrapper-{{ ai_gen_id }} {
    border-color: #D4A853;
    box-shadow: 0 0 0 3px rgba(212, 168, 83, 0.35);
  }

  .gm-occasions-item-{{ ai_gen_id }}:focus-visible .gm-occasions-image-wrapper-{{ ai_gen_id }} {
    outline: none;
    border-color: #D4A853;
    box-shadow: 0 0 0 3px rgba(212, 168, 83, 0.6);
  }

  .gm-occasions-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .gm-occasions-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gm-occasions-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.25;
  }

  .gm-occasions-name-{{ ai_gen_id }} {
    font-family: var(--font-body-family);
    font-size: {{ block.settings.name_size }}px;
    font-weight: 500;
    color: {{ block.settings.name_color }};
    text-align: center;
    max-width: {{ block.settings.image_size }}px;
    word-wrap: break-word;
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .gm-occasions-item-{{ ai_gen_id }}:hover .gm-occasions-name-{{ ai_gen_id }} {
    color: #D4A853;
  }

  @media screen and (max-width: 749px) {
    .gm-occasions-image-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.image_size | times: 0.8 }}px;
      height: {{ block.settings.image_size | times: 0.8 }}px;
    }

    .gm-occasions-name-{{ ai_gen_id }} {
      max-width: {{ block.settings.image_size | times: 0.8 }}px;
      font-size: {{ block.settings.name_size | times: 0.9 }}px;
    }

    .gm-occasions-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="gm-occasions-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="gm-occasions-container-{{ ai_gen_id }} {{ block.settings.layout }}">
    {% if block.settings.title != blank %}
      <h2 class="gm-occasions-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
    {% endif %}

    <div class="gm-occasions-list-{{ ai_gen_id }}">
      {% if block.settings.collections != blank %}
        {% for collection in block.settings.collections %}
          <a href="{{ collection.url }}" class="gm-occasions-item-{{ ai_gen_id }}">
            <div class="gm-occasions-image-wrapper-{{ ai_gen_id }}">
              {% if collection.featured_image %}
                <img
                  src="{{ collection.featured_image | image_url: width: 300 }}"
                  alt="{{ collection.featured_image.alt | escape }}"
                  class="gm-occasions-image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="300"
                  height="300"
                >
              {% else %}
                <div class="gm-occasions-placeholder-{{ ai_gen_id }}">
                  {{ 'collection-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            <span class="gm-occasions-name-{{ ai_gen_id }}">{{ collection.title }}</span>
          </a>
        {% endfor %}
      {% else %}
        {% for i in (1..6) %}
          <div class="gm-occasions-item-{{ ai_gen_id }}">
            <div class="gm-occasions-image-wrapper-{{ ai_gen_id }}">
              <div class="gm-occasions-placeholder-{{ ai_gen_id }}">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            </div>
            <span class="gm-occasions-name-{{ ai_gen_id }}">Collection {{ i }}</span>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shop by Occasion",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Section width",
      "options": [
        {
          "value": "full-width",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Container"
        }
      ],
      "default": "container"
    },
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by Occasion"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 28
    },
    {
      "type": "select",
      "id": "title_alignment",
      "label": "Title alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#2A2018"
    },
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "image_size",
      "min": 60,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Image size",
      "default": 100
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Spacing between items",
      "default": 20
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 8,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 2
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#D4A853"
    },
    {
      "type": "color",
      "id": "image_background",
      "label": "Image background",
      "default": "#FAF8F1"
    },
    {
      "type": "header",
      "content": "Collection name"
    },
    {
      "type": "range",
      "id": "name_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Name size",
      "default": 14
    },
    {
      "type": "color",
      "id": "name_color",
      "label": "Name color",
      "default": "#2A2018"
    },
    {
      "type": "header",
      "content": "Hover effect"
    },
    {
      "type": "range",
      "id": "hover_lift",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Hover lift distance",
      "default": 8
    },
    {
      "type": "color",
      "id": "scrollbar_color",
      "label": "Scrollbar color",
      "default": "#D4A853"
    }
  ],
  "presets": [
    {
      "name": "Shop by Occasion"
    }
  ]
}
{% endschema %}
