{% doc %}
  @prompt
    generate a horizontal menu list
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-horizontal-menu-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-horizontal-menu__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-horizontal-menu__list-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ block.settings.alignment }};
    gap: {{ block.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-horizontal-menu__item-{{ ai_gen_id }} {
    margin: 0;
  }

  .ai-horizontal-menu__link-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.link_padding_vertical }}px {{ block.settings.link_padding_horizontal }}px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    transition: color 0.3s ease, background-color 0.3s ease;
    border-radius: {{ block.settings.link_border_radius }}px;
  }

  .ai-horizontal-menu__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.text_hover_color }};
    background-color: {{ block.settings.link_hover_background }};
  }

  @media screen and (max-width: 749px) {
    .ai-horizontal-menu__list-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_alignment }};
    }
  }
{% endstyle %}

<horizontal-menu-{{ ai_gen_id }} class="ai-horizontal-menu-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-horizontal-menu__container-{{ ai_gen_id }}">
    <ul class="ai-horizontal-menu__list-{{ ai_gen_id }}">
      {% if block.settings.menu != blank %}
        {% for link in block.settings.menu.links %}
          <li class="ai-horizontal-menu__item-{{ ai_gen_id }}">
            <a href="{{ link.url }}" class="ai-horizontal-menu__link-{{ ai_gen_id }}">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      {% else %}
        {% for i in (1..5) %}
          <li class="ai-horizontal-menu__item-{{ ai_gen_id }}">
            <a href="#" class="ai-horizontal-menu__link-{{ ai_gen_id }}">
              Menu item {{ i }}
            </a>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</horizontal-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class HorizontalMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.links = this.querySelectorAll('.ai-horizontal-menu__link-{{ ai_gen_id }}');
        this.setupAccessibility();
      }

      setupAccessibility() {
        this.links.forEach((link) => {
          link.addEventListener('focus', function() {
            this.style.outline = '2px solid currentColor';
            this.style.outlineOffset = '2px';
          });

          link.addEventListener('blur', function() {
            this.style.outline = '';
            this.style.outlineOffset = '';
          });
        });
      }
    }

    customElements.define('horizontal-menu-{{ ai_gen_id }}', HorizontalMenu{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Horizontal menu",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Menu"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 600,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Desktop alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        },
        {
          "value": "space-between",
          "label": "Space between"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Mobile alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Item spacing",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Link style"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "link_padding_vertical",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Link vertical padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "link_padding_horizontal",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Link horizontal padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "link_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Link border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#faf8f1"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "text_hover_color",
      "label": "Text hover",
      "default": "#f44546"
    },
    {
      "type": "color",
      "id": "link_hover_background",
      "label": "Link hover background",
      "default": "rgba(244, 69, 70, 0.1)"
    }
  ],
  "presets": [
    {
      "name": "Horizontal menu"
    }
  ]
}
{% endschema %}
