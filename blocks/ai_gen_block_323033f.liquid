{% doc %}
  @prompt
    create a section with a carrousel of 5 customer testimonials. Each customer should have a small circuler portrait picture
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 60px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonials-carousel__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.desktop_width_percent }}%;
    margin: 0 auto;
  }

  .ai-testimonials-carousel__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-testimonials-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 12px;
  }

  .ai-testimonials-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-testimonials-carousel__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin-bottom: 30px;
  }

  .ai-testimonials-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: 24px;
    transition: transform 0.5s ease;
  }

  .ai-testimonials-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    min-width: 0;
  }

  .ai-testimonials-carousel__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-testimonials-carousel__image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.image_size }}px;
    height: {{ block.settings.image_size }}px;
    margin: 0 auto 20px;
    border-radius: 50%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-testimonials-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-testimonials-carousel__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-testimonials-carousel__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-testimonials-carousel__quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 20px;
    font-style: italic;
  }

  .ai-testimonials-carousel__author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: 600;
    margin: 0 0 4px;
  }

  .ai-testimonials-carousel__role-{{ ai_gen_id }} {
    font-size: {{ block.settings.role_size }}px;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
    margin: 0;
  }

  .ai-testimonials-carousel__rating-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 4px;
    margin-bottom: 16px;
  }

  .ai-testimonials-carousel__star-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonials-carousel__controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
  }

  .ai-testimonials-carousel__button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid {{ block.settings.button_color }};
    background-color: transparent;
    color: {{ block.settings.button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-testimonials-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
  }

  .ai-testimonials-carousel__button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonials-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-testimonials-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    background-color: {{ block.settings.button_color }};
    opacity: 0.3;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-testimonials-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (min-width: 750px) {
    .ai-testimonials-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc(50% - 12px);
    }
  }

  @media screen and (min-width: 990px) {
    .ai-testimonials-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc(33.333% - 16px);
    }
  }
{% endstyle %}

<testimonials-carousel-{{ ai_gen_id }}
  class="ai-testimonials-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonials-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subtitle != blank %}
      <div class="ai-testimonials-carousel__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-testimonials-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-testimonials-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-testimonials-carousel__track-wrapper-{{ ai_gen_id }}">
      <div class="ai-testimonials-carousel__track-{{ ai_gen_id }}" data-track>
        {% for i in (1..5) %}
          {% liquid
            assign image_key = 'testimonial_' | append: i | append: '_image'
            assign quote_key = 'testimonial_' | append: i | append: '_quote'
            assign author_key = 'testimonial_' | append: i | append: '_author'
            assign role_key = 'testimonial_' | append: i | append: '_role'
            assign rating_key = 'testimonial_' | append: i | append: '_rating'

            assign image = block.settings[image_key]
            assign quote = block.settings[quote_key]
            assign author = block.settings[author_key]
            assign role = block.settings[role_key]
            assign rating = block.settings[rating_key]
          %}

          <div class="ai-testimonials-carousel__slide-{{ ai_gen_id }}">
            <div class="ai-testimonials-carousel__card-{{ ai_gen_id }}">
              <div class="ai-testimonials-carousel__image-wrapper-{{ ai_gen_id }}">
                {% if image %}
                  <img
                    src="{{ image | image_url: width: 200 }}"
                    alt="{{ author | escape }}"
                    class="ai-testimonials-carousel__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div class="ai-testimonials-carousel__image-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.show_rating and rating > 0 %}
                <div class="ai-testimonials-carousel__rating-{{ ai_gen_id }}">
                  {% for star in (1..rating) %}
                    <svg class="ai-testimonials-carousel__star-{{ ai_gen_id }}" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                      <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                    </svg>
                  {% endfor %}
                </div>
              {% endif %}

              {% if quote != blank %}
                <p class="ai-testimonials-carousel__quote-{{ ai_gen_id }}">"{{ quote }}"</p>
              {% else %}
                <p class="ai-testimonials-carousel__quote-{{ ai_gen_id }}">"Add your customer testimonial here"</p>
              {% endif %}

              {% if author != blank %}
                <p class="ai-testimonials-carousel__author-{{ ai_gen_id }}">{{ author }}</p>
              {% endif %}

              {% if role != blank %}
                <p class="ai-testimonials-carousel__role-{{ ai_gen_id }}">{{ role }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-testimonials-carousel__controls-{{ ai_gen_id }}">
      <button
        class="ai-testimonials-carousel__button-{{ ai_gen_id }}"
        data-prev
        aria-label="Previous testimonial"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="ai-testimonials-carousel__dots-{{ ai_gen_id }}" data-dots></div>

      <button
        class="ai-testimonials-carousel__button-{{ ai_gen_id }}"
        data-next
        aria-label="Next testimonial"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  </div>
</testimonials-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.slides = this.querySelectorAll('.ai-testimonials-carousel__slide-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');

        this.slidesPerView = this.getSlidesPerView();
        this.totalSlides = this.slides.length;
        this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);

        this.createDots();
        this.updateCarousel();
        this.setupEventListeners();
        this.startAutoplay();

        window.addEventListener('resize', () => {
          this.slidesPerView = this.getSlidesPerView();
          this.maxIndex = Math.max(0, this.totalSlides - this.slidesPerView);
          this.currentIndex = Math.min(this.currentIndex, this.maxIndex);
          this.updateCarousel();
        });
      }

      getSlidesPerView() {
        if (window.innerWidth >= 990) return 3;
        if (window.innerWidth >= 750) return 2;
        return 1;
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        const dotsCount = this.maxIndex + 1;
        
        for (let i = 0; i < dotsCount; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-testimonials-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());
      }

      updateCarousel() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = 24;
        const offset = -(this.currentIndex * (slideWidth + gap));
        
        this.track.style.transform = 'translateX(' + offset + 'px)';

        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.maxIndex;

        const dots = this.dotsContainer.querySelectorAll('.ai-testimonials-carousel__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateCarousel();
        }
      }

      next() {
        if (this.currentIndex < this.maxIndex) {
          this.currentIndex++;
          this.updateCarousel();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateCarousel();
      }

      startAutoplay() {
        if ({{ block.settings.autoplay }}) {
          this.autoplayInterval = setInterval(() => {
            if (this.currentIndex >= this.maxIndex) {
              this.currentIndex = 0;
            } else {
              this.currentIndex++;
            }
            this.updateCarousel();
          }, {{ block.settings.autoplay_speed }} * 1000);
        }
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('testimonials-carousel-{{ ai_gen_id }}', TestimonialsCarousel{{ ai_gen_id }});
  })();
</script>

