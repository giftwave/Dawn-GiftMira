{% doc %}
  @prompt
    Create a sections showing 4 rows of Icon and text showing trust factors like free shipping, customer service times, return window and secure payments, change to columns
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-trust-factors-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: 40px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-trust-factors-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    width: {{ block.settings.desktop_width_percent }}%;
  }

  .ai-trust-factors-list-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.column_spacing }}px;
  }

  .ai-trust-factor-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.alignment }};
    text-align: {{ block.settings.alignment }};
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
  }

  .ai-trust-factor-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
    margin-bottom: {{ block.settings.icon_text_gap }}px;
  }

  .ai-trust-factor-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-trust-factor-content-{{ ai_gen_id }} {
    width: 100%;
  }

  .ai-trust-factor-title-{{ ai_gen_id }} {
    margin: 0 0 4px 0;
    font-size: {{ block.settings.title_size }}px;
    font-weight: 600;
    color: {{ block.settings.title_color }};
  }

  .ai-trust-factor-text-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-trust-factors-list-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-trust-factors-container-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-trust-factors-list-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-trust-factor-icon-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-trust-factor-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.9 }}px;
    }

    .ai-trust-factor-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<trust-factors-{{ ai_gen_id }} class="ai-trust-factors-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-factors-container-{{ ai_gen_id }}">
    <div class="ai-trust-factors-list-{{ ai_gen_id }}">
      {% if block.settings.factor_1_enabled %}
        <div class="ai-trust-factor-item-{{ ai_gen_id }}">
          <div class="ai-trust-factor-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          </div>
          <div class="ai-trust-factor-content-{{ ai_gen_id }}">
            <h3 class="ai-trust-factor-title-{{ ai_gen_id }}">{{ block.settings.factor_1_title }}</h3>
            <p class="ai-trust-factor-text-{{ ai_gen_id }}">{{ block.settings.factor_1_text }}</p>
          </div>
        </div>
      {% endif %}

      {% if block.settings.factor_2_enabled %}
        <div class="ai-trust-factor-item-{{ ai_gen_id }}">
          <div class="ai-trust-factor-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="ai-trust-factor-content-{{ ai_gen_id }}">
            <h3 class="ai-trust-factor-title-{{ ai_gen_id }}">{{ block.settings.factor_2_title }}</h3>
            <p class="ai-trust-factor-text-{{ ai_gen_id }}">{{ block.settings.factor_2_text }}</p>
          </div>
        </div>
      {% endif %}

      {% if block.settings.factor_3_enabled %}
        <div class="ai-trust-factor-item-{{ ai_gen_id }}">
          <div class="ai-trust-factor-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="9 11 12 14 22 4"></polyline>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
            </svg>
          </div>
          <div class="ai-trust-factor-content-{{ ai_gen_id }}">
            <h3 class="ai-trust-factor-title-{{ ai_gen_id }}">{{ block.settings.factor_3_title }}</h3>
            <p class="ai-trust-factor-text-{{ ai_gen_id }}">{{ block.settings.factor_3_text }}</p>
          </div>
        </div>
      {% endif %}

      {% if block.settings.factor_4_enabled %}
        <div class="ai-trust-factor-item-{{ ai_gen_id }}">
          <div class="ai-trust-factor-icon-{{ ai_gen_id }}">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
          </div>
          <div class="ai-trust-factor-content-{{ ai_gen_id }}">
            <h3 class="ai-trust-factor-title-{{ ai_gen_id }}">{{ block.settings.factor_4_title }}</h3>
            <p class="ai-trust-factor-text-{{ ai_gen_id }}">{{ block.settings.factor_4_text }}</p>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</trust-factors-{{ ai_gen_id }}>

<script>
  (function() {
    class TrustFactors{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
      }
    }

    customElements.define('trust-factors-{{ ai_gen_id }}', TrustFactors{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Trust factors",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 400,
      "max": 1600,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "column_spacing",
      "label": "Space between columns",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_padding",
      "label": "Item padding",
      "min": 8,
      "max": 40,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "label": "Icon to text spacing",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#faf8f1"
    },
    {
      "type": "color",
      "id": "item_background_color",
      "label": "Item background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#f44546"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#1f1f1f"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "item_border_radius",
      "label": "Item border radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Factor 1 - Free shipping"
    },
    {
      "type": "checkbox",
      "id": "factor_1_enabled",
      "label": "Enable",
      "default": true
    },
    {
      "type": "text",
      "id": "factor_1_title",
      "label": "Title",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "factor_1_text",
      "label": "Text",
      "default": "On orders over $50"
    },
    {
      "type": "header",
      "content": "Factor 2 - Customer service"
    },
    {
      "type": "checkbox",
      "id": "factor_2_enabled",
      "label": "Enable",
      "default": true
    },
    {
      "type": "text",
      "id": "factor_2_title",
      "label": "Title",
      "default": "24/7 Support"
    },
    {
      "type": "text",
      "id": "factor_2_text",
      "label": "Text",
      "default": "Contact us anytime"
    },
    {
      "type": "header",
      "content": "Factor 3 - Returns"
    },
    {
      "type": "checkbox",
      "id": "factor_3_enabled",
      "label": "Enable",
      "default": true
    },
    {
      "type": "text",
      "id": "factor_3_title",
      "label": "Title",
      "default": "30-Day Returns"
    },
    {
      "type": "text",
      "id": "factor_3_text",
      "label": "Text",
      "default": "Easy returns within 30 days"
    },
    {
      "type": "header",
      "content": "Factor 4 - Secure payments"
    },
    {
      "type": "checkbox",
      "id": "factor_4_enabled",
      "label": "Enable",
      "default": true
    },
    {
      "type": "text",
      "id": "factor_4_title",
      "label": "Title",
      "default": "Secure Payments"
    },
    {
      "type": "text",
      "id": "factor_4_text",
      "label": "Text",
      "default": "100% secure checkout"
    }
  ],
  "presets": [
    {
      "name": "Trust factors"
    }
  ]
}
{% endschema %}
