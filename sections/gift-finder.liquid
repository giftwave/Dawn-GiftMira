        <span class="gf-progress__dot" data-step="4"></span>
      </div>
      <p class="gf-progress__label" id="gf-step-label">Step 1 of 4</p>

      <!-- Step 1: Who is it for? -->
      <div class="gf-step active" data-step="1">
        <h2 class="gf-step__heading">Who are you shopping for?</h2>
        <div class="gf-options" id="gf-recipient-options">
          <div class="gf-option" data-value="partner">
            <span class="gf-option__icon">💑</span>
            <span class="gf-option__label">Partner</span>
          </div>
          <div class="gf-option" data-value="parent">
            <span class="gf-option__icon">👨‍👩‍👧</span>
            <span class="gf-option__label">Parent</span>
          </div>
          <div class="gf-option" data-value="friend">
            <span class="gf-option__icon">👯</span>
            <span class="gf-option__label">Friend</span>
          </div>
          <div class="gf-option" data-value="sibling">
            <span class="gf-option__icon">👫</span>
            <span class="gf-option__label">Sibling</span>
          </div>
          <div class="gf-option" data-value="child">
            <span class="gf-option__icon">🧒</span>
            <span class="gf-option__label">Child</span>
          </div>
          <div class="gf-option" data-value="coworker">
            <span class="gf-option__icon">🤝</span>
            <span class="gf-option__label">Coworker</span>
          </div>
        </div>
        <div class="gf-nav gf-nav--center">
          <button class="gf-btn gf-btn--primary" id="gf-next-1" disabled>Next →</button>
        </div>
        <div class="gf-skip"><a onclick="GiftFinder.skip(1)">Skip this question</a></div>
      </div>

      <!-- Step 2: What's the occasion? -->
      <div class="gf-step" data-step="2">
        <h2 class="gf-step__heading">What's the occasion?</h2>
        <div class="gf-options" id="gf-occasion-options">
          <div class="gf-option" data-value="birthday">
            <span class="gf-option__icon">🎂</span>
            <span class="gf-option__label">Birthday</span>
          </div>
          <div class="gf-option" data-value="anniversary">
            <span class="gf-option__icon">💍</span>
            <span class="gf-option__label">Anniversary</span>
          </div>
          <div class="gf-option" data-value="just-because">
            <span class="gf-option__icon">🎁</span>
            <span class="gf-option__label">Just Because</span>
          </div>
          <div class="gf-option" data-value="holiday">
            <span class="gf-option__icon">🎄</span>
            <span class="gf-option__label">Holiday</span>
          </div>
          <div class="gf-option" data-value="graduation">
            <span class="gf-option__icon">🎓</span>
            <span class="gf-option__label">Graduation</span>
          </div>
          <div class="gf-option" data-value="thank-you">
            <span class="gf-option__icon">🙏</span>
            <span class="gf-option__label">Thank You</span>
          </div>
        </div>
        <div class="gf-nav">
          <button class="gf-btn gf-btn--secondary" onclick="GiftFinder.goTo(1)">← Back</button>
          <button class="gf-btn gf-btn--primary" id="gf-next-2" disabled>Next →</button>
        </div>
        <div class="gf-skip"><a onclick="GiftFinder.skip(2)">Skip this question</a></div>
      </div>

      <!-- Step 3: What are their interests? (multi-select) -->
      <div class="gf-step" data-step="3">
        <h2 class="gf-step__heading">What are they into? <span style="font-size: 1.4rem; font-weight: 400; color: rgba(var(--color-foreground), 0.5);">Select as many as you like</span></h2>
        <div class="gf-options" id="gf-interest-options">
          <div class="gf-option" data-value="tech-gadget-gifts">
            <span class="gf-option__icon">🤖</span>
            <span class="gf-option__label">Tech & Gadgets</span>
          </div>
          <div class="gf-option" data-value="music-lover-gifts">
            <span class="gf-option__icon">🎵</span>
            <span class="gf-option__label">Music Lover</span>
          </div>
          <div class="gf-option" data-value="outdoor-adventure-gifts">
            <span class="gf-option__icon">🏕️</span>
            <span class="gf-option__label">Outdoors</span>
          </div>
          <div class="gf-option" data-value="home-decor-gifts">
            <span class="gf-option__icon">🏠</span>
            <span class="gf-option__label">Home & Decor</span>
          </div>
          <div class="gf-option" data-value="gaming-gifts">
            <span class="gf-option__icon">🎮</span>
            <span class="gf-option__label">Gaming</span>
          </div>
          <div class="gf-option" data-value="cosplay-collectibles">
            <span class="gf-option__icon">🦸</span>
