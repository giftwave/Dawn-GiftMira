<style>
  .gf-section {
    padding: 4rem 1.5rem 6rem;
    background: rgb(var(--color-background));
  }

  .gf-wrapper {
    max-width: 720px;
    margin: 0 auto;
  }

  /* Header */
  .gf-header {
    text-align: center;
    margin-bottom: 3.2rem;
  }

  .gf-header h1 {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(2.8rem, 5vw, 4rem);
    color: rgb(var(--color-foreground));
    margin: 0 0 0.8rem;
  }

  .gf-header p {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.65);
    margin: 0;
  }

  /* Progress bar */
  .gf-progress {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    margin-bottom: 3rem;
  }

  .gf-progress__dot {
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: rgba(var(--color-foreground), 0.2);
    transition: background 0.2s ease;
  }

  .gf-progress__dot.active {
    background: #FF6B6B;
    transform: scale(1.25);
  }

  .gf-progress__dot.done {
    background: #22C55E;
  }

  .gf-progress__label {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.5);
    text-align: center;
    margin-bottom: 1.6rem;
  }

  /* Step */
  .gf-step {
    display: none;
  }

  .gf-step.active {
    display: block;
    animation: gf-fade-in 0.25s ease;
  }

  @keyframes gf-fade-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .gf-step__heading {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 2.8rem);
    color: rgb(var(--color-foreground));
    text-align: center;
    margin: 0 0 2.4rem;
  }

  /* Option cards grid */
  .gf-options {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-bottom: 3rem;
  }

  @media screen and (min-width: 750px) {
    .gf-options {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.6rem;
    }
  }

  .gf-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    padding: 1.6rem 0.8rem;
    background: rgb(var(--color-background));
    border: 2px solid rgba(var(--color-foreground), 0.12);
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    text-align: center;
    user-select: none;
    min-height: 100px;
  }

  .gf-option:hover {
    border-color: rgba(255, 107, 107, 0.5);
    box-shadow: 0 2px 12px rgba(255, 107, 107, 0.12);
  }

  .gf-option.selected {
    border-color: #FF6B6B;
    background: rgba(255, 107, 107, 0.06);
    box-shadow: 0 2px 12px rgba(255, 107, 107, 0.18);
    transform: translateY(-2px);
  }

  .gf-option__icon {
    font-size: 2.8rem;
    line-height: 1;
  }

  .gf-option__label {
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    font-weight: 500;
    color: rgb(var(--color-foreground));
    line-height: 1.3;
  }

  /* Budget pills */
  .gf-budget {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .gf-budget-pill {
    padding: 1rem 2.4rem;
    border: 2px solid rgba(var(--color-foreground), 0.2);
    border-radius: 40px;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 500;
    cursor: pointer;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .gf-budget-pill:hover {
    border-color: #FF6B6B;
  }

  .gf-budget-pill.selected {
    border-color: #FF6B6B;
    background: #FF6B6B;
    color: #ffffff;
  }

  /* Navigation buttons */
  .gf-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.8rem;
  }

  .gf-nav--center {
    justify-content: center;
  }

  .gf-btn {
    padding: 1.2rem 2.8rem;
    border-radius: 26px;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: opacity 0.15s ease;
  }

  .gf-btn:hover {
    opacity: 0.88;
  }

  .gf-btn--primary {
    background: #FF6B6B;
    color: #ffffff;
    flex: 1;
  }

  .gf-btn--secondary {
    background: transparent;
    color: rgba(var(--color-foreground), 0.6);
    border: 1px solid rgba(var(--color-foreground), 0.2);
  }

  .gf-btn--find {
    background: #FF6B6B;
    color: #ffffff;
    width: 100%;
    font-size: 1.7rem;
    padding: 1.4rem 2rem;
  }

  .gf-skip {
    text-align: center;
    margin-top: 1.2rem;
  }

  .gf-skip a {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.5);
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  /* Loading state */
  .gf-loading {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem;
    text-align: center;
  }

  .gf-loading.active {
    display: flex;
  }

  .gf-spinner {
    width: 4rem;
    height: 4rem;
    border: 3px solid rgba(var(--color-foreground), 0.1);
    border-top-color: #FF6B6B;
    border-radius: 50%;
    animation: gf-spin 0.7s linear infinite;
    margin-bottom: 1.6rem;
  }

  @keyframes gf-spin {
    to { transform: rotate(360deg); }
  }

  .gf-loading p {
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0;
  }

  /* Interest chips in results */
  .gf-interest-chips {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.4rem 0 0;
  }

  .gf-interest-chips__label {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    color: rgba(var(--color-foreground), 0.5);
    margin-right: 0.2rem;
  }

  .gf-interest-chip {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1.2rem;
    border-radius: 40px;
    border: 1.5px solid rgba(var(--color-foreground), 0.18);
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    font-weight: 500;
    cursor: pointer;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
    user-select: none;
  }

  .gf-interest-chip:hover {
    border-color: #FF6B6B;
  }

  .gf-interest-chip.active {
    border-color: #FF6B6B;
    background: #FF6B6B;
    color: #ffffff;
  }

  /* Results */
  .gf-results {
    display: none;
    margin-top: 0;
  }

  .gf-results.active {
    display: block;
    animation: gf-fade-in 0.3s ease;
  }

  .gf-results__header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  .gf-results__title {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    color: rgb(var(--color-foreground));
    margin: 0 0 0.8rem;
  }

  .gf-results__subtitle {
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    color: rgba(var(--color-foreground), 0.6);
    margin: 0 0 1.6rem;
  }

  .gf-results__restart {
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    color: #FF6B6B;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .gf-product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.6rem;
  }

  @media screen and (min-width: 750px) {
    .gf-product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    .gf-product-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .gf-product-card {
    display: flex;
    flex-direction: column;
    background: rgb(var(--color-background));
    text-decoration: none;
    color: inherit;
  }

  .gf-product-card:hover .gf-product-image {
    transform: scale(1.03);
  }

  .gf-product-image-wrap {
    overflow: hidden;
    background: rgba(var(--color-foreground), 0.04);
    aspect-ratio: 1 / 1;
    margin-bottom: 1rem;
  }

  .gf-product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    display: block;
  }

  .gf-product-title {
    font-family: var(--font-heading-family);
    font-weight: 700;
    font-size: 1.3rem;
    color: rgb(var(--color-foreground));
    margin: 0 0 0.4rem;
    line-height: 1.4;
  }

  .gf-product-price {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin: 0;
  }

  .gf-no-results {
    text-align: center;
    padding: 4rem 2rem;
    display: none;
  }

  .gf-no-results.active {
    display: block;
  }

  .gf-no-results p {
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    color: rgba(var(--color-foreground), 0.6);
    margin-bottom: 2rem;
  }
</style>

<div class="gf-section">
  <div class="gf-wrapper">

    <!-- Header -->
    <div class="gf-header">
      <h1>Find the Perfect Gift</h1>
      <p>Answer 4 quick questions and we'll find exactly what they'll love.</p>
