    <div class="gf-no-results" id="gf-no-results">
      <p>We couldn't find products in that price range — try widening your budget.</p>
      <button class="gf-btn gf-btn--secondary" onclick="GiftFinder.restart()">← Start Over</button>
    </div>

    <!-- Results -->
    <div class="gf-results" id="gf-results">
      <div class="gf-results__header">
        <h2 class="gf-results__title" id="gf-results-title">We found gifts they'll love</h2>
        <p class="gf-results__subtitle" id="gf-results-subtitle"></p>
        <div class="gf-interest-chips" id="gf-result-interest-chips"></div>
        <button class="gf-results__restart" onclick="GiftFinder.restart()">← Start over</button>
      </div>
      <div class="gf-product-grid" id="gf-product-grid"></div>
    </div>

  </div>
</div>

<script>
var GiftFinder = (function () {
  var state = {
    step: 1,
    recipient: null,
    occasion: null,
    interests: [],
    budgetMin: 0,
    budgetMax: 999999
  };

  var recipientLabels = {
    partner: 'your partner', parent: 'a parent', friend: 'a friend',
    sibling: 'a sibling', child: 'a child', coworker: 'a coworker'
  };

  var ALL_COLLECTIONS = [
    'tech-gadget-gifts', 'music-lover-gifts', 'outdoor-adventure-gifts',
    'home-decor-gifts', 'gaming-gifts', 'cosplay-collectibles',
    'jewelry', 'best-sellers', 'luxury-gifts'
  ];

  var interestToCollections = {
    'tech-gadget-gifts':       ['tech-gadget-gifts'],
    'music-lover-gifts':       ['music-lover-gifts'],
    'outdoor-adventure-gifts': ['outdoor-adventure-gifts'],
    'home-decor-gifts':        ['home-decor-gifts', 'housewarming-gifts'],
    'gaming-gifts':            ['gaming-gifts'],
    'cosplay-collectibles':    ['cosplay-collectibles', 'dragon-ball-z'],
    'jewelry':                 ['jewelry'],
    'best-sellers':            ['best-sellers'],
    'luxury-gifts':            ['luxury-gifts']
  };

  function init() {
    // Step 1 single-select
    bindSingleSelect('gf-recipient-options', function (val) {
      state.recipient = val;
      document.getElementById('gf-next-1').disabled = false;
    });

    // Step 2 single-select
    bindSingleSelect('gf-occasion-options', function (val) {
      state.occasion = val;
      document.getElementById('gf-next-2').disabled = false;
    });

    // Step 3 multi-select (0 selected = show all interests)
    bindMultiSelect('gf-interest-options', function (vals) {
      state.interests = vals;
    });

    // Budget pills
    document.querySelectorAll('.gf-budget-pill').forEach(function (pill) {
      pill.addEventListener('click', function () {
        document.querySelectorAll('.gf-budget-pill').forEach(function (p) { p.classList.remove('selected'); });
        pill.classList.add('selected');
        state.budgetMin = parseInt(pill.dataset.min);
        state.budgetMax = parseInt(pill.dataset.max);
        document.getElementById('gf-find-btn').disabled = false;
      });
    });

    // Next buttons
    document.getElementById('gf-next-1').addEventListener('click', function () { goTo(2); });
    document.getElementById('gf-next-2').addEventListener('click', function () { goTo(3); });
    document.getElementById('gf-next-3').addEventListener('click', function () { goTo(4); });
    document.getElementById('gf-find-btn').addEventListener('click', findGifts);
  }

  function bindSingleSelect(containerId, onChange) {
    document.getElementById(containerId).querySelectorAll('.gf-option').forEach(function (opt) {
      opt.addEventListener('click', function () {
        document.getElementById(containerId).querySelectorAll('.gf-option').forEach(function (o) { o.classList.remove('selected'); });
        opt.classList.add('selected');
        onChange(opt.dataset.value);
      });
    });
  }

  function bindMultiSelect(containerId, onChange) {
    document.getElementById(containerId).querySelectorAll('.gf-option').forEach(function (opt) {
      opt.addEventListener('click', function () {
        opt.classList.toggle('selected');
        var selected = Array.from(document.getElementById(containerId).querySelectorAll('.gf-option.selected')).map(function (o) { return o.dataset.value; });
        onChange(selected);
      });
    });
  }

  function goTo(step) {
    document.querySelectorAll('.gf-step').forEach(function (s) { s.classList.remove('active'); });
    document.querySelector('.gf-step[data-step="' + step + '"]').classList.add('active');
    state.step = step;
    updateProgress();
    window.scrollTo({ top: document.querySelector('.gf-section').offsetTop - 80, behavior: 'smooth' });
  }

  function updateProgress() {
    document.getElementById('gf-step-label').textContent = 'Step ' + state.step + ' of 4';
    document.querySelectorAll('.gf-progress__dot').forEach(function (dot) {
      var dotStep = parseInt(dot.dataset.step);
      dot.classList.remove('active', 'done');
      if (dotStep === state.step) dot.classList.add('active');
      else if (dotStep < state.step) dot.classList.add('done');
    });
  }

  function skip(currentStep) {
    if (currentStep === 1) state.recipient = null;
    if (currentStep === 2) state.occasion = null;
    if (currentStep === 3) state.interests = [];
    if (currentStep < 4) goTo(currentStep + 1);
    else findGifts();
  }

  async function findGifts(keepQuizHidden) {
    // Hide quiz, show loading
    if (!keepQuizHidden) {
      document.getElementById('gf-quiz').style.display = 'none';
    }
    document.getElementById('gf-loading').classList.add('active');
    document.getElementById('gf-results').classList.remove('active');
    document.getElementById('gf-no-results').classList.remove('active');

    try {
      var collections;
      if (state.interests.length > 0) {
        collections = [];
        state.interests.forEach(function (interest) {
          (interestToCollections[interest] || []).forEach(function (c) {
            if (collections.indexOf(c) === -1) collections.push(c);
          });
        });
        if (collections.length === 0) collections = ALL_COLLECTIONS.slice();
      } else {
        collections = ALL_COLLECTIONS.slice();
      }

      var allProducts = [];
      var seen = {};

      for (var i = 0; i < collections.length; i++) {
        var handle = collections[i];
        try {
          var res = await fetch('/collections/' + handle + '/products.json?limit=250');
          if (!res.ok) continue;
          var data = await res.json();
          (data.products || []).forEach(function (p) {
            if (!seen[p.id]) {
              seen[p.id] = true;
              allProducts.push(p);
            }
          });
        } catch (e) { /* skip failed collection */ }
      }

      // Apply budget filter
      var filtered = allProducts.filter(function (p) {
        var price = parseInt(p.variants && p.variants[0] ? p.variants[0].price * 100 : 0);
        return price >= state.budgetMin && price <= state.budgetMax;
      });

      // Shuffle for variety
      filtered = filtered.sort(function () { return Math.random() - 0.5; });

      // Show up to 12
      var toShow = filtered.slice(0, 12);

      document.getElementById('gf-loading').classList.remove('active');

      if (toShow.length === 0) {
        document.getElementById('gf-no-results').classList.add('active');
        return;
      }

      renderResults(toShow, allProducts.length, filtered.length);
    } catch (err) {
      document.getElementById('gf-loading').classList.remove('active');
      document.getElementById('gf-no-results').classList.add('active');
    }
  }

  var allInterestOptions = [
    { value: 'tech-gadget-gifts',       icon: '🤖', label: 'Tech & Gadgets' },
    { value: 'music-lover-gifts',       icon: '🎵', label: 'Music Lover' },
    { value: 'outdoor-adventure-gifts', icon: '🏕️', label: 'Outdoors' },
    { value: 'home-decor-gifts',        icon: '🏠', label: 'Home & Decor' },
    { value: 'gaming-gifts',            icon: '🎮', label: 'Gaming' },
    { value: 'cosplay-collectibles',    icon: '🦸', label: 'Cosplay & Anime' },
    { value: 'jewelry',                 icon: '💎', label: 'Jewelry' },
    { value: 'best-sellers',            icon: '😂', label: 'Funny & Novelty' },
    { value: 'luxury-gifts',            icon: '✨', label: 'Luxury' }
  ];

  function renderInterestChips() {
    var container = document.getElementById('gf-result-interest-chips');
    if (!container) return;

    var label = document.createElement('span');
    label.className = 'gf-interest-chips__label';
    label.textContent = 'Interests:';
    container.innerHTML = '';
    container.appendChild(label);

    allInterestOptions.forEach(function (opt) {
      var chip = document.createElement('button');
      chip.className = 'gf-interest-chip' + (state.interests.indexOf(opt.value) !== -1 ? ' active' : '');
      chip.textContent = opt.icon + ' ' + opt.label;
      chip.addEventListener('click', function () {
        var idx = state.interests.indexOf(opt.value);
        if (idx !== -1) {
          state.interests.splice(idx, 1);
        } else {
          state.interests.push(opt.value);
        }
        chip.classList.toggle('active');
        // Re-fetch with updated interests
        document.getElementById('gf-product-grid').innerHTML = '';
        var loadingEl = document.getElementById('gf-loading');
        document.getElementById('gf-results').classList.remove('active');
        loadingEl.classList.add('active');
        findGifts(true);
      });
      container.appendChild(chip);
    });
  }

  function renderResults(products, totalFetched, filteredCount) {
    var recipientLabel = state.recipient ? recipientLabels[state.recipient] : 'them';
    var countLabel = filteredCount > 12 ? '12+ gifts' : filteredCount + ' gift' + (filteredCount !== 1 ? 's' : '');

    document.getElementById('gf-results-title').textContent = 'We found ' + countLabel + ' for ' + recipientLabel;
    document.getElementById('gf-results-subtitle').textContent = state.occasion
      ? 'Perfect for ' + state.occasion.replace(/-/g, ' ') + ' — curated just for you.'
      : 'Curated just for you.';

    var grid = document.getElementById('gf-product-grid');
    grid.innerHTML = '';

    products.forEach(function (product) {
      var img = product.images && product.images[0] ? product.images[0].src : null;
      var price = product.variants && product.variants[0] ? parseFloat(product.variants[0].price) : 0;
      var priceFormatted = '$' + price.toFixed(2).replace(/\.00$/, '');

      var card = document.createElement('a');
      card.href = '/products/' + product.handle;
      card.className = 'gf-product-card';
      card.innerHTML = '<div class="gf-product-image-wrap">'
        + (img ? '<img class="gf-product-image" src="' + img.replace(/\.(jpg|png|gif|webp)/, '_400x400.$1') + '" alt="' + escapeHtml(product.title) + '" loading="lazy">' : '<div class="gf-product-image" style="background: rgba(var(--color-foreground),0.06)"></div>')
        + '</div>'
        + '<p class="gf-product-title">' + escapeHtml(product.title) + '</p>'
        + '<p class="gf-product-price">' + priceFormatted + '</p>';

      grid.appendChild(card);
    });

    renderInterestChips();
    document.getElementById('gf-results').classList.add('active');
  }

  function escapeHtml(str) {
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function restart() {
    state = { step: 1, recipient: null, occasion: null, interests: [], budgetMin: 0, budgetMax: 999999 };
    // Reset all selections
    document.querySelectorAll('.gf-option').forEach(function (o) { o.classList.remove('selected'); });
    document.querySelectorAll('.gf-budget-pill').forEach(function (p) { p.classList.remove('selected'); });
    document.getElementById('gf-next-1').disabled = true;
    document.getElementById('gf-next-2').disabled = true;
    document.getElementById('gf-next-3').disabled = true;
    document.getElementById('gf-find-btn').disabled = true;
    document.getElementById('gf-results').classList.remove('active');
    document.getElementById('gf-no-results').classList.remove('active');
    document.getElementById('gf-quiz').style.display = '';
    goTo(1);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  return { goTo: goTo, skip: skip, restart: restart };
})();
</script>

