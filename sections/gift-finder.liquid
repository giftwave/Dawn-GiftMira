            <span class="gf-option__icon">😂</span>
            <span class="gf-option__label">Funny & Novelty</span>
          </div>
          <div class="gf-option" data-value="luxury-gifts">
            <span class="gf-option__icon">✨</span>
            <span class="gf-option__label">Luxury</span>
          </div>
        </div>
        <div class="gf-nav">
          <button class="gf-btn gf-btn--secondary" onclick="GiftFinder.goTo(2)">← Back</button>
          <button class="gf-btn gf-btn--primary" id="gf-next-3">Next →</button>
        </div>
      </div>

      <!-- Step 4: Budget -->
      <div class="gf-step" data-step="4">
        <h2 class="gf-step__heading">What's your budget?</h2>
        <div class="gf-budget" id="gf-budget-options">
          <button class="gf-budget-pill" data-min="0" data-max="3000">Under $30</button>
          <button class="gf-budget-pill" data-min="3000" data-max="6000">$30 – $60</button>
          <button class="gf-budget-pill" data-min="6000" data-max="10000">$60 – $100</button>
          <button class="gf-budget-pill" data-min="10000" data-max="999999">$100+</button>
